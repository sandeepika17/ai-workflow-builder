* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: #f4f7fb;
  color: #14213d;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

/* =========================
   AUTH
========================= */

.auth-page {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 24px;

  background:
    radial-gradient(
      circle at top left,
      #e9eef9,
      transparent 40%
    ),
    #f4f7fb;
}

.auth-card {
  width: min(440px, 100%);

  background: white;

  border: 1px solid #dce3ed;
  border-radius: 22px;

  padding: 42px;

  box-shadow:
    0 24px 70px rgba(20, 33, 61, 0.12);
}

.auth-logo {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  border-radius: 14px;

  background: #14213d;
  color: white;

  font-weight: 800;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 10px;

  font-size: 0.75rem;
  font-weight: 800;

  letter-spacing: 0.16em;

  color: #60708a;
}

.auth-card h1 {
  margin: 0;

  font-size: 2.1rem;
  letter-spacing: -0.04em;
}

.auth-subtitle {
  margin: 12px 0 28px;

  color: #65758e;
  line-height: 1.6;
}

.auth-card form {
  display: grid;
  gap: 18px;
}

.auth-card label {
  display: grid;
  gap: 8px;

  font-size: 0.9rem;
  font-weight: 700;
  color: #26344d;
}

.auth-card input {
  width: 100%;

  padding: 13px 14px;

  border: 1px solid #ccd5e2;
  border-radius: 10px;

  outline: none;

  background: white;
  color: #14213d;
}

.auth-card input:focus {
  border-color: #14213d;

  box-shadow:
    0 0 0 3px rgba(20, 33, 61, 0.08);
}

.primary-button {
  border: 0;
  border-radius: 10px;

  padding: 14px;

  background: #14213d;
  color: white;

  font-weight: 800;

  margin-top: 4px;
}

.primary-button:hover {
  background: #202f4c;
}

.primary-button:disabled {
  opacity: 0.6;
  cursor: wait;
}

.auth-error,
.auth-success {
  border-radius: 10px;
  padding: 12px 14px;

  font-size: 0.9rem;
  line-height: 1.5;
}

.auth-error {
  background: #fff1f1;
  border: 1px solid #f0b9b9;
  color: #b42318;
}

.auth-success {
  background: #effbf3;
  border: 1px solid #b9e5c5;
  color: #137333;
}

.auth-switch {
  margin-top: 24px;

  display: flex;
  justify-content: center;
  gap: 5px;

  color: #65758e;

  font-size: 0.9rem;
}

.auth-switch button {
  border: 0;
  padding: 0;

  background: transparent;

  color: #14213d;

  font-weight: 800;
}

/* =========================
   APPLICATION SHELL
========================= */

.app-shell {
  min-height: 100vh;

  display: flex;

  background: #f4f7fb;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  width: 300px;

  display: flex;
  flex-direction: column;

  padding: 28px 22px;

  background: #101827;
  color: white;
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;

  padding: 4px 12px 30px;
}

.brand-icon {
  width: 46px;
  height: 46px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background: white;
  color: #14213d;

  font-weight: 900;
}

.brand strong {
  display: block;

  font-size: 1rem;
}

.brand span {
  display: block;

  margin-top: 4px;

  color: #91a0b7;

  font-size: 0.8rem;
}

.sidebar-nav {
  display: grid;
  gap: 7px;
}

.nav-item {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 14px;

  padding: 14px;

  border: 0;
  border-radius: 10px;

  background: transparent;
  color: #9eabc0;

  text-align: left;

  font-weight: 600;
}

.nav-item span {
  width: 18px;
  text-align: center;
}

.nav-item.active,
.nav-item:hover {
  background: #202b3d;
  color: white;
}

.workspace-user {
  margin-top: auto;

  display: flex;
  align-items: center;
  gap: 11px;

  padding: 15px;

  border-radius: 12px;

  background: #182235;
}

.user-avatar {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #dce6f5;
  color: #14213d;

  font-weight: 800;
}

.workspace-user strong {
  display: block;

  font-size: 0.85rem;
}

.workspace-user span:last-child {
  display: block;

  max-width: 175px;

  margin-top: 3px;

  overflow: hidden;

  text-overflow: ellipsis;

  color: #8796ad;

  font-size: 0.72rem;
}

/* =========================
   WORKSPACE
========================= */

.workspace {
  flex: 1;

  min-width: 0;

  padding: 52px 54px;
}

.workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;

  margin-bottom: 34px;
}

.workspace-header h1 {
  margin: 0;

  font-size: clamp(2.3rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -0.05em;
}

.workspace-header > div:first-child > p:last-child {
  margin: 15px 0 0;

  color: #60708a;

  font-size: 1.05rem;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.new-workflow,
.logout-button {
  border: 0;
  border-radius: 10px;

  padding: 14px 20px;

  font-weight: 800;
}

.new-workflow {
  background: #14213d;
  color: white;
}

.logout-button {
  background: #fff1f1;
  color: #b42318;
}

/* =========================
   STATS
========================= */

.stats {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 18px;

  margin-bottom: 24px;
}

.stat-card {
  padding: 22px;

  background: white;

  border: 1px solid #dce3ed;
  border-radius: 16px;
}

.stat-card span {
  display: block;

  color: #60708a;

  font-size: 0.85rem;
}

.stat-card strong {
  display: block;

  margin-top: 10px;

  font-size: 2rem;
}

/* =========================
   WORKFLOWS
========================= */

.workflow-section {
  padding: 32px;

  background: white;

  border: 1px solid #dce3ed;
  border-radius: 18px;

  box-shadow:
    0 10px 30px rgba(20, 33, 61, 0.04);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 28px;
}

.section-heading h2 {
  margin: 0;

  font-size: 1.5rem;
}

.section-heading p {
  margin: 8px 0 0;

  color: #65758e;
}

.count {
  min-width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #eef2f7;

  font-weight: 800;
}

.workflow-grid {
  display: grid;

  grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));

  gap: 18px;
}

.workflow-card {
  padding: 22px;

  border: 1px solid #dce3ed;
  border-radius: 15px;

  background: #fbfcfe;
}

.workflow-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workflow-icon {
  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background: #eef3f9;

  color: #14213d;
}

.ready {
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 7px 10px;

  border-radius: 20px;

  background: #effbf3;
  color: #137333;

  font-size: 0.75rem;
  font-weight: 800;
}

.ready span {
  font-size: 0.6rem;
}

.workflow-card h3 {
  margin: 22px 0 7px;

  font-size: 1.15rem;
}

.workflow-card p {
  margin: 0;

  color: #60708a;
}

.workflow-divider {
  height: 1px;

  margin: 22px 0;

  background: #e1e6ee;
}

.workflow-card small {
  display: block;

  color: #60708a;

  font-weight: 700;
}

.workflow-card code {
  display: block;

  margin-top: 4px;

  color: #53627a;

  font-size: 0.75rem;

  overflow-wrap: anywhere;
}

.open-workflow {
  width: 100%;

  margin-top: 20px;

  padding: 13px;

  border: 0;
  border-radius: 10px;

  background: #14213d;
  color: white;

  font-weight: 800;
}

.status {
  color: #60708a;
}

.error {
  padding: 18px;

  border: 1px solid #f1b8b8;
  border-radius: 12px;

  background: #fff7f7;
  color: #b42318;

  overflow-x: auto;
}

.error h3 {
  margin-top: 0;
}

.error pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {
  .sidebar {
    width: 220px;
  }

  .workspace {
    padding: 35px 25px;
  }

  .workspace-header {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 700px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    width: 100%;
    padding: 15px;
  }

  .brand {
    padding-bottom: 15px;
  }

  .sidebar-nav {
    grid-template-columns: repeat(3, 1fr);
  }

  .workspace-user {
    display: none;
  }

  .workspace {
    padding: 25px 15px;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .workflow-section {
    padding: 20px;
  }

  .workflow-grid {
    grid-template-columns: 1fr;
  }

  .auth-card {
    padding: 28px 22px;
  }
}